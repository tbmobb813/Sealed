# Shared monorepo env (API reads this when you run from repo root)
# Web app uses apps/web/.env.local — see apps/web/.env.example

# Database (password matches docker-compose POSTGRES_PASSWORD)
DATABASE_URL=postgresql://sealed:sealed_dev@localhost:5432/sealed

# Redis
REDIS_URL=redis://localhost:6379

# Demo mode (API: skip Clerk — use seeded demo user)
DEMO_MODE=true

# Clerk (not required when DEMO_MODE=true)
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Dropbox Sign
DROPBOX_SIGN_API_KEY=...
DROPBOX_SIGN_WEBHOOK_SECRET=

# Resend
RESEND_API_KEY=re_your_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev
NEXT_PUBLIC_APP_URL=http://localhost:3000

# App
PORT=3001
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Signature provider: dropbox_sign (default) | docuseal
SIGNATURE_PROVIDER=dropbox_sign
DOCUSEAL_API_KEY=
DOCUSEAL_WEBHOOK_SECRET=
# DOCUSEAL_API_URL=https://api.docuseal.com

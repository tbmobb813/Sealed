{
  "name": "@sealed/database",
  "version": "0.0.0",
  "private": true,
  "main": "./generated/client/index.js",
  "types": "./generated/client/index.d.ts",
  "exports": {
    ".": {
      "types": "./generated/client/index.d.ts",
      "default": "./generated/client/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate --schema ../../apps/api/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "7.9.1"
  },
  "devDependencies": {
    "@sealed/config": "workspace:*",
    "prisma": "7.9.1",
    "typescript": "^5.8.3"
  }
}

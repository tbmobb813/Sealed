# Database
DATABASE_URL="postgresql://sealed:sealed_dev@localhost:5432/sealed"

# Demo mode (skip Clerk — use seeded demo user)
DEMO_MODE=true

# Clerk (get from clerk.com dashboard; not required when DEMO_MODE=true)
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# Stripe (use test mode keys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Dropbox Sign
DROPBOX_SIGN_API_KEY=...
DROPBOX_SIGN_TEST_MODE=true

# Resend
RESEND_API_KEY=re_...

# App
API_PORT=3001
WEB_URL=http://localhost:3000
# Signature provider: dropbox_sign (default) | docuseal
SIGNATURE_PROVIDER=dropbox_sign
DOCUSEAL_API_KEY=
DOCUSEAL_WEBHOOK_SECRET=

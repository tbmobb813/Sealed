# Database
DATABASE_URL="postgresql://sealed:sealed_dev@localhost:5432/sealed"

# Demo mode (skip Clerk — use seeded demo user)
DEMO_MODE=true

# Clerk (get from clerk.com dashboard; not required when DEMO_MODE=true)
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# Stripe (use test mode keys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend
RESEND_API_KEY=re_...

# App
API_PORT=3001
WEB_URL=http://localhost:3000
# The web app's origin. Required in production (server refuses to boot
# without it). Used both for CORS and as Clerk's `authorizedParties` allowlist
# (see https://clerk.com/docs/references/backend/verify-token) — must match
# WEB_URL exactly, scheme + host + port, no trailing slash.
CORS_ORIGIN=http://localhost:3000

# E-signatures (DocuSeal is the only provider)
DOCUSEAL_API_KEY=key_...
# Shared secret DocuSeal sends back in the X-Webhook-Secret header — required
# for webhook verification.
DOCUSEAL_WEBHOOK_SECRET=whsec_...
# DOCUSEAL_API_URL=https://api.docuseal.com

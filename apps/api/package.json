{
  "name": "@sealed/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "dotenv -e ../../.env -e .env -- nest start --watch",
    "start": "node dist/src/main",
    "lint": "eslint \"{src,prisma}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "db:migrate": "dotenv -e ../../.env -e .env -- prisma migrate dev",
    "db:seed": "dotenv -e ../../.env -e .env -- tsx prisma/seed.ts",
    "db:studio": "dotenv -e ../../.env -e .env -- prisma studio",
    "db:migrate:deploy": "dotenv -e ../../.env -e .env -- prisma migrate deploy",
    "test": "dotenv -e ../../.env -e .env -- jest --runInBand",
    "test:unit": "dotenv -e ../../.env -e .env -- jest --testPathPatterns=src/",
    "test:integration": "dotenv -e ../../.env -e .env -- jest --runInBand --testPathPatterns=tests/integration/"
  },
  "dependencies": {
    "@clerk/backend": "^3.16.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "6.9.0",
    "@sealed/database": "workspace:*",
    "@sealed/types": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.18.1",
    "rxjs": "^7.8.2",
    "stripe": "^18.5.0",
    "svix": "^1.99.1",
    "zod": "^3.25.42"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.28",
    "@sealed/config": "workspace:*",
    "@types/express": "^5.0.2",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.15.29",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.27.0",
    "jest": "^30.4.2",
    "prisma": "6.9.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.9",
    "typescript": "^5.8.3"
  }
}
